                          "withdrawn"
                        ]
                      },
                      "related_records": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
                        },
                        "uniqueItems": true,
                        "maxItems": 50
                      },
                      "attributed_to": {
                        "type": "string",
