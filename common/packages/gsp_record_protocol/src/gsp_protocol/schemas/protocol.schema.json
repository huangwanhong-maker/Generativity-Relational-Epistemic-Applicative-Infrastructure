                },
                "required": [
                  "op"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "protocol_version",
        "transaction_id",
        "expected_head",
        "reason",
        "change_categories",
        "operations"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "project": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
            },
            "schema_version": {
              "enum": [
                "gsp-workspace/0.1",
                "gsp-workspace/0.2"
              ]
            },
            "profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "id",
            "schema_version"
          ],
          "additionalProperties": true
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Record"
          },
          "maxItems": 1000
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
        }
      },
      "required": [
        "project",
        "records",
        "head"
      ],
      "additionalProperties": true
    },
    "EventOrderData": {
      "type": "object",
      "properties": {
        "before": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "after": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "TemporalBound": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "event"
            },
            "event_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "event_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "unbounded",
                "unknown"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TemporalExtentData": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/TemporalBound"
        },
        "end": {
          "$ref": "#/$defs/TemporalBound"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "subject_record_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        }
      },
      "required": [
        "start",
        "end",
        "basis"
      ],
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Transaction"
    },
    {
      "$ref": "#/$defs/Snapshot"
    }
  ]
}
