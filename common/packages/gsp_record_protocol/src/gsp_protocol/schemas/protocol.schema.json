                      },
                      "method": {
                        "type": "string",
                        "maxLength": 2000,
                        "minLength": 0
                      },
                      "evidence": {
                        "type": "string",
                        "maxLength": 5000,
                        "minLength": 0
                      },
                      "uncertainty": {
                        "type": "string",
                        "maxLength": 3000,
                        "minLength": 0
                      },
                      "alternatives": {
                        "type": "string",
                        "maxLength": 3000,
