                          "State",
                          "Event",
                          "Process",
                          "Relation",
                          "Property"
                        ]
                      },
                      "record_roles": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "Entity",
                            "State",
                            "Event",
                            "Process",
                            "Relation",
                            "Property"
                          ]
                        },
                        "uniqueItems": true,
                        "minItems": 1,
                        "maxItems": 6
