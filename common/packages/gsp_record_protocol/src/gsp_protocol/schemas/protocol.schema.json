        "protocol_version": {
          "const": "gsp-record-protocol/0.2"
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "expected_head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
        },
        "reason": {
          "type": "string",
          "maxLength": 2000,
          "minLength": 1
        },
        "change_categories": {
          "type": "array",
          "items": {
            "enum": [
              "description",
              "represented_change",
              "evidence_or_interpretation",
              "classification",
              "maintenance",
              "migration"
            ]
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "record.create"
                  },
                  "record": {
                    "type": "object",
