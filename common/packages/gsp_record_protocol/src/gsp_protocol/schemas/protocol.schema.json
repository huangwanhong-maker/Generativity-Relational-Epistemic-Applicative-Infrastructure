                        "minLength": 0
                      },
                      "alternatives": {
                        "type": "string",
                        "maxLength": 3000,
                        "minLength": 0
                      },
                      "conditions": {
                        "type": "string",
                        "maxLength": 3000,
                        "minLength": 0
                      },
                      "consequences": {
                        "type": "string",
                        "maxLength": 3000,
                        "minLength": 0
                      },
                      "occurred_at": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 0
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
                      },
                      "modules": {
                        "type": "object",
                        "propertyNames": {
                          "pattern": "^[a-z][a-z0-9_-]*(?:[.:][a-z][a-z0-9_-]*)+(?![\\s\\S])",
                          "maxLength": 100
                        },
                        "additionalProperties": {
                          "$ref": "#/$defs/Module"
                        },
                        "maxProperties": 32
